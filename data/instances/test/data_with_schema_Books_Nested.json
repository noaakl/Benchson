{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "author": {
        "type": "string",
        "minLength": 1
      },
      "genre": {
        "type": "string",
        "enum": [
          "Fiction",
          "Non-Fiction",
          "Mystery",
          "Science Fiction",
          "Fantasy",
          "Biography",
          "History",
          "Self-Help"
        ]
      },
      "publishedYear": {
        "type": "integer",
        "minimum": 0
      },
      "price": {
        "type": "number",
        "minimum": 0
      },
      "inStock": {
        "type": "boolean"
      },
      "reviews": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "rating": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "comment": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reviewer",
            "rating",
            "comment"
          ],
          "additionalProperties": false
        }
      },
      "publisher": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "object",
            "properties": {
              "street": {
                "type": "string",
                "minLength": 1
              },
              "city": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "instances": [
    {
      "title": "The Great Gatsby",
      "author": "F. Scott Fitzgerald",
      "genre": "Fiction",
      "publishedYear": 1925,
      "price": 10.99,
      "inStock": true,
      "reviews": [
        {
          "reviewer": "John Doe",
          "rating": 5,
          "comment": "A timeless classic!"
        }
      ],
      "publisher": {
        "name": "Scribner",
        "address": {
          "street": "123 Main St",
          "city": "New York"
        }
      }
    },
    {
      "title": "1984",
      "author": "George Orwell",
      "genre": "Science Fiction",
      "publishedYear": 1949,
      "price": 8.99,
      "inStock": true,
      "reviews": [
        {
          "reviewer": "Jane Smith",
          "rating": 4,
          "comment": "A chilling dystopian novel."
        }
      ],
      "publisher": {
        "name": "Secker & Warburg",
        "address": {
          "street": "456 Elm St",
          "city": "London"
        }
      }
    },
    {
      "title": "To Kill a Mockingbird",
      "author": "Harper Lee",
      "genre": "Fiction",
      "publishedYear": 1960,
      "price": 7.99,
      "inStock": true,
      "reviews": [
        {
          "reviewer": "Alice Johnson",
          "rating": 5,
          "comment": "A powerful story about justice and compassion."
        }
      ],
      "publisher": {
        "name": "J.B. Lippincott & Co.",
        "address": {}
      }
    }
  ]
}