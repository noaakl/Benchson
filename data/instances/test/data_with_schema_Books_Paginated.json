{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "currentPage": {
        "type": "integer",
        "minimum": 1
      },
      "totalPages": {
        "type": "integer",
        "minimum": 1
      },
      "totalItems": {
        "type": "integer",
        "minimum": 0
      },
      "itemsPerPage": {
        "type": "integer",
        "minimum": 1
      },
      "books": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "author": {
              "type": "string",
              "minLength": 1
            },
            "isbn": {
              "type": "string",
              "pattern": "^[0-9]{13}$"
            },
            "publishedDate": {
              "type": "string",
              "format": "date"
            },
            "genre": {
              "type": "string",
              "enum": [
                "Fiction",
                "Non-Fiction",
                "Mystery",
                "Science Fiction",
                "Fantasy",
                "Biography",
                "History",
                "Self-Help"
              ]
            },
            "price": {
              "type": "number",
              "minimum": 0
            },
            "rating": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "inStock": {
              "type": "boolean"
            },
            "reviews": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "instances": [
    {
      "currentPage": 1,
      "totalPages": 10,
      "totalItems": 100,
      "itemsPerPage": 10,
      "books": [
        {
          "title": "The Great Gatsby",
          "author": "F. Scott Fitzgerald",
          "isbn": "9780743273565",
          "publishedDate": "1925-04-10",
          "genre": "Fiction",
          "price": 10.99,
          "rating": 4.5,
          "inStock": true,
          "reviews": [
            {
              "reviewer": "John Doe"
            }
          ]
        }
      ]
    },
    {
      "currentPage": 2,
      "totalPages": 10,
      "totalItems": 100,
      "itemsPerPage": 10,
      "books": [
        {
          "title": "1984",
          "author": "George Orwell",
          "isbn": "9780451524935",
          "publishedDate": "1949-06-08",
          "genre": "Science Fiction",
          "price": 12.99,
          "rating": 4.8,
          "inStock": true,
          "reviews": [
            {
              "reviewer": "Jane Smith"
            }
          ]
        }
      ]
    },
    {
      "currentPage": 3,
      "totalPages": 10,
      "totalItems": 100,
      "itemsPerPage": 10,
      "books": [
        {
          "title": "To Kill a Mockingbird",
          "author": "Harper Lee",
          "isbn": "9780061120084",
          "publishedDate": "196"
        }
      ]
    }
  ]
}