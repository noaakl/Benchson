{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "author": {
        "type": "string",
        "minLength": 1
      },
      "genre": {
        "type": "string",
        "enum": [
          "Fiction",
          "Non-Fiction",
          "Mystery",
          "Science Fiction",
          "Fantasy",
          "Biography",
          "History",
          "Self-Help"
        ]
      },
      "publicationYear": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 2023
      },
      "price": {
        "type": "number",
        "minimum": 0
      },
      "inStock": {
        "type": "boolean"
      },
      "reviews": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "rating": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "comment": {
              "type": "string"
            }
          },
          "required": [
            "reviewer",
            "rating"
          ],
          "additionalProperties": false
        },
        "minItems": 1,
        "maxItems": 100
      },
      "publisher": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "name"
        ]
      }
    }
  },
  "instances": [
    {
      "title": "The Great Gatsby",
      "author": "F. Scott Fitzgerald",
      "genre": "Fiction",
      "publicationYear": 1925,
      "price": 12.99,
      "inStock": true,
      "reviews": [
        {
          "reviewer": "John Doe",
          "rating": 5,
          "comment": "A timeless classic!"
        }
      ],
      "publisher": {
        "name": "Scribner",
        "address": "123 Main St",
        "contactEmail": "info@scribner.com"
      }
    },
    {
      "title": "1984",
      "author": "George Orwell",
      "genre": "Science Fiction",
      "publicationYear": 1949,
      "price": 9.99,
      "inStock": true,
      "reviews": [
        {
          "reviewer": "Jane Smith",
          "rating": 4,
          "comment": "A chilling dystopian novel."
        }
      ],
      "publisher": {
        "name": "Secker & Warburg",
        "address": "456 Elm St",
        "contactEmail": "contact@seckerwarburg.com"
      }
    },
    {
      "title": "To Kill a Mockingbird",
      "author": "Harper Lee",
      "genre": "Fiction",
      "publicationYear": 1960,
      "price": 8.99,
      "inStock": true,
      "reviews": [
        {
          "reviewer": "Alice Johnson",
          "rating": 5,
          "comment": "A powerful story about justice and compassion."
        }
      ],
      "publisher": {
        "name": "J.B. Lippincott & Co.",
        "address": "789 Oak St"
      }
    }
  ]
}