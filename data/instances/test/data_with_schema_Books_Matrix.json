{
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "author": {
        "type": "string",
        "minLength": 1
      },
      "publishedYear": {
        "type": "integer",
        "minimum": 0
      },
      "price": {
        "type": "number",
        "minimum": 0
      },
      "inStock": {
        "type": "boolean"
      },
      "genres": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "reviews": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "rating": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "comment": {
              "type": "string"
            }
          },
          "required": [
            "reviewer",
            "rating"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      },
      "chapters": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "chapterNumber": {
              "type": "integer",
              "minimum": 1
            },
            "chapterTitle": {
              "type": "string",
              "minLength": 1
            },
            "pages": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "chapterNumber",
            "chapterTitle",
            "pages"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "instances": [
    {
      "title": "The Great Gatsby",
      "author": "F. Scott Fitzgerald",
      "publishedYear": 1925,
      "price": 10.99,
      "inStock": true,
      "genres": [
        "Fiction",
        "Classic"
      ],
      "reviews": [
        {
          "reviewer": "John Doe",
          "rating": 5,
          "comment": "A timeless classic!"
        }
      ],
      "chapters": [
        {
          "chapterNumber": 1,
          "chapterTitle": "Introduction",
          "pages": 20
        }
      ]
    },
    {
      "title": "1984",
      "author": "George Orwell",
      "publishedYear": 1949,
      "price": 8.99,
      "inStock": true,
      "genres": [
        "Dystopian",
        "Science Fiction"
      ],
      "reviews": [
        {
          "reviewer": "Jane Smith",
          "rating": 4,
          "comment": "A chilling vision of the future."
        }
      ],
      "chapters": [
        {
          "chapterNumber": 1,
          "chapterTitle": "The Beginning",
          "pages": 15
        }
      ]
    }
  ]
}